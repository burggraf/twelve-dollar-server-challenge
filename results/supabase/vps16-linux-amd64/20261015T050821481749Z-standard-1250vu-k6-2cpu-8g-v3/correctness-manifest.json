        "functions": [
          {
            "acl": [
              "feed_owner=X/feed_owner",
              "feed_writer=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_api.create_post(p_body_b64 text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$\n DECLARE post_id bigint;\n BEGIN\n  INSERT INTO feed_data.posts(user_id,body) VALUES(feed_data.writer_id(),decode(p_body_b64,'base64')) RETURNING id INTO post_id;\n  RETURN feed_data.post_json(post_id);\n END $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner",
              "feed_reader=X/feed_owner",
              "anon=X/feed_owner",
              "authenticated=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_api.detail(p_post_id bigint)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$ SELECT feed_data.post_json(p_post_id) $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner",
              "feed_reader=X/feed_owner",
              "anon=X/feed_owner",
              "authenticated=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_api.feed()\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$\n SELECT coalesce(jsonb_agg(feed_data.post_json(p.id) ORDER BY p.created_at DESC,p.id DESC),'[]'::jsonb)\n FROM (SELECT id,created_at FROM feed_data.posts ORDER BY created_at DESC,id DESC LIMIT 20) p\n $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner",
              "feed_reader=X/feed_owner",
              "anon=X/feed_owner",
              "authenticated=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_api.health()\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$\n BEGIN PERFORM 1 FROM feed_data.users LIMIT 1; RETURN true; END $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner",
              "feed_writer=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_api.like_post(p_post_id bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$\n DECLARE changed integer; user_id bigint := feed_data.writer_id();\n BEGIN\n  IF NOT EXISTS(SELECT FROM feed_data.posts WHERE id=p_post_id) THEN RETURN NULL; END IF;\n  INSERT INTO feed_data.likes(user_id,post_id) VALUES(user_id,p_post_id) ON CONFLICT DO NOTHING RETURNING 1 INTO changed;\n  RETURN jsonb_build_object('liked',true,'post_id',p_post_id,'already_liked',changed IS NULL);\n END $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_data.codepoints(value bytea)\n RETURNS bigint\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\n SET search_path TO 'pg_catalog'\nAS $function$ SELECT count(*) FROM generate_series(0,octet_length(value)-1) n WHERE (get_byte(value,n)&192)<>128 $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_data.post_json(p_id bigint)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO 'pg_catalog', 'feed_data'\nAS $function$\n SELECT jsonb_build_object('id',p.id,'body_b64',encode(p.body,'base64'),'created_at',p.created_at,'author',u.username,\n 'like_count',(SELECT count(*) FROM feed_data.likes l WHERE l.post_id=p.id))\n FROM feed_data.posts p JOIN feed_data.users u ON u.id=p.user_id WHERE p.id=p_id\n $function$\n"
          },
          {
            "acl": [
              "feed_owner=X/feed_owner"
            ],
            "owner": "feed_owner",
            "definition": "CREATE OR REPLACE FUNCTION feed_data.writer_id()\n RETURNS bigint\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'pg_catalog'\nAS $function$\n DECLARE value text := nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'app_user_id';\n BEGIN\n  IF value IS NULL OR value !~ '^[1-9][0-9]*$' OR length(value)>19 THEN RAISE insufficient_privilege; END IF;\n  RETURN value::bigint;\n EXCEPTION WHEN numeric_value_out_of_range OR invalid_text_representation THEN RAISE insufficient_privilege;\n END $function$\n"
          }
        ],
